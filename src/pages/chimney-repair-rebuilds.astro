---
import Base from '../layouts/Base.astro';
import ServiceHero from '../components/ServiceHero.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Faq from '../components/Faq.astro';
import ClosingCta from '../components/ClosingCta.astro';

import { IMG } from '../lib/images.js';
const CH = `${IMG}/2024/12/chimney-new.png`;

const symptoms = [
  { title: 'Water Leaking',          body: 'Moisture entering your attic or fireplace is a sign of structural failure.' },
  { title: 'Crumbling Mortar',       body: 'Worn out joints weaken the stack and allow freeze-thaw damage.' },
  { title: 'Loose or Cracked Brick', body: 'Bricks that are splitting or falling pose a safety hazard to your property.' },
  { title: 'Leaning Stack',          body: 'A lean indicates severe foundation or structural compromise requiring urgent attention.' },
];

const services = [
  { icon: CH, alt: 'chimney-new', title: 'Chimney Repointing',    body: 'Expertly removing old, cracked mortar and replacing it with high-strength material to restore structural integrity.' },
  { icon: CH, alt: 'chimney-new', title: 'Partial / Full Rebuilds', body: 'When structural damage is severe, we rebuild from the roofline up, ensuring a perfect brick match every time.' },
  { icon: CH, alt: 'chimney-new', title: 'Sealing & Crowns',      body: 'Installing or repairing masonry caps and crowns to divert water away from the chimney face and prevent leaks.' },
];

const faqs = [
  { q: 'Repair vs. Rebuild: How do I know?', a: 'If only the mortar is crumbling but the bricks are solid, a repoint (repair) is usually enough. If bricks are falling out, the stack is leaning, or there is significant interior water damage, a rebuild from the roofline or lower may be necessary.' },
  { q: 'Can you match my existing bricks?', a: 'Yes. We source from multiple brickyards across the GTA to find the closest possible match in size, texture, and color, even for heritage homes.' },
  { q: 'How long does a typical chimney job take?', a: 'Repointing typically takes 1-2 days. A full rebuild usually takes 2-4 days depending on the height and access requirements. We include setup and a spotless cleanup in that timeframe.' },
  { q: 'What causes chimney leaks?', a: 'The most common causes are cracked masonry crowns (the concrete top), failing flashing where the chimney meets the roof, or porous, spalling bricks that absorb water.' },
];
---
<Base title="Chimney Repair & Rebuilds – Brian's Masonry"
      description="Chimney leaking or crumbling? From repointing to full rebuilds, Brian's Masonry fixes brick chimneys across the GTA — sealed, solid, and safe.">

  <ServiceHero
    h1="Chimney Repair & Rebuilds Across the GTA"
    sub="Chimney Leaking or Crumbling? We Repair and Rebuild."
    lede="From repointing to full rebuilds, Brian's Masonry fixes brick chimneys across the GTA — sealed, solid, and safe."
    ticks={['20+ years of chimney repair in the GTA', 'Multiple HomeStars Best of Awards', 'Repairs that stop leaks for good', 'Brick matched on rebuilds', 'Spotless cleanup']} />

  <section class="sec">
    <div class="wrap">
      <div class="grid g2 problem">
        <img src={`${IMG}/2024/12/Brians-Masonry-About-Us-Image.webp`}
             alt="Brian's Masonry - About Us Image" loading="lazy" class="problem__img" />
        <div>
          <h2 class="h2">A failing chimney lets in water and gets worse fast.</h2>
          <div class="grid g2 sym">
            {symptoms.map(s => (
              <div><h3>{s.title}</h3><p>{s.body}</p></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <ServiceGrid heading="What we do for chimneys" items={services} />
  <Faq items={faqs} />
  <ClosingCta image={`${IMG}/2024/12/chimney-e1738015791924.png`} alt="chimney"
    heading="Don't wait for the next storm."
    body="Get a professional assessment and a fixed quote for your chimney repair today. We serve Toronto, Etobicoke, Mississauga, and the entire GTA." />
</Base>

<style>
  .problem { align-items: center; }
  .problem__img { border-radius: var(--radius); }
  .sym { margin-top: 20px; gap: 18px 26px; }
  .sym h3 { font-size: 1.15rem; margin-bottom: .25em; }
  .sym p { font-size: .96rem; color: var(--slate); margin: 0; }
</style>
