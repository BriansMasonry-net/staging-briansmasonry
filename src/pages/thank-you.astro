---
import Base from '../layouts/Base.astro';
export const prerender = true;
---
{/*
  The old wp-sitemap listed /thank-you/ and the page was indexable. It should
  not be either. It cannot rank, and an organic visitor landing on it straight
  from a search result would fire the Google Ads Lead Form conversion without
  ever having submitted the form — poisoning the conversion data the client
  optimises their ad spend on. So: noindex,follow (the links still pass), and
  filtered out of the sitemap in astro.config.mjs.

  `conversion` carries the event snippet that was on this page and only this
  page on the old site.
*/}
<Base title="Thank You – Brian's Masonry"
      description="Thanks for getting in touch with Brian's Masonry. We have your details and we'll be back to you shortly to arrange your free estimate."
      noindex={true}
      conversion={true}>
  <section class="sec ty">
    <div class="wrap">
      <h1 class="h2 h2--c">Thank You</h1>
      <p>Thanks for reaching out to Brian&rsquo;s Masonry. We&rsquo;ve got your details and we&rsquo;ll
         be in touch shortly to arrange your free estimate.</p>
      <p>Need us sooner? Call <a href="tel:4162444113">(416) 244-4113</a>.</p>
      <p><a class="btn" href="/">Back to home</a></p>
    </div>
  </section>
</Base>

<style>
  .ty { padding: 90px 0; }
  .ty .wrap { max-width: 720px; text-align: center; }
</style>
