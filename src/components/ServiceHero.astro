---
import EstimateForm from './EstimateForm.astro';
// Service-page hero. The live pages' own Elementor CSS 404s, so their intended
// look is unavailable; this applies the homepage design language.
const { h1, sub, lede, ticks } = Astro.props;
---
<section class="shero">
  <div class="wrap shero__in">
    <div>
      <h1 class="shero__h">{h1}</h1>
      {sub  && <h2 class="shero__sub">{sub}</h2>}
      {lede && <p class="shero__lede">{lede}</p>}
      <a class="btn" href="#Contact"><small>Get a Quote</small>(416) 244-4113</a>
      {ticks && <ul class="ticks shero__ticks">{ticks.map((t) => <li>{t}</li>)}</ul>}
    </div>
    <EstimateForm id="top-estimate" />
  </div>
</section>

<style>
  .shero { background: var(--blue); color: #fff; padding: 50px 0; }
  .shero__in { display: grid; grid-template-columns: 1fr auto; gap: 60px; align-items: center; }
  .shero__h { font-size: 40px; font-weight: 600; color: #fff; margin-bottom: .25em; }
  .shero__sub { font-size: 22px; font-weight: 600; color: #fff; margin-bottom: .5em; }
  .shero__lede { font-size: 18px; color: #e7eaf6; max-width: 62ch; margin-bottom: 1.2em; }
  .shero__btn { background: #fff; color: var(--blue); }
  .shero__ticks { margin-top: 22px; color: #fff; }
  @media (max-width: 980px) {
    .shero__in { grid-template-columns: 1fr; gap: 30px; }
    .shero__h { font-size: 29px; }
  }
</style>
