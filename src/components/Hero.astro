---
import EstimateForm from './EstimateForm.astro';
import Img from './Img.astro';
// #97e7705 — min-height 85vh (500px <=1024), overlay #000000D4 @ .5,
// justify center, align flex-start, background slideshow cover/center.
import { IMAGE_HOST as IMG } from '../../seo.config';
const slides = [
  `${IMG}/2025/01/Brians-Masonry-Home-Page-Banner.webp`,
  `${IMG}/2025/01/Brians-Masonry-Banner-Image-2.webp`,
  `${IMG}/2025/01/Brians-Masonry-Banner-Image-3.webp`,
];
/* The old homepage had no <h1> at all — every heading on it, including the one
   that says what the business does, was an <h2>. Promoted to <h1>; the classes
   carry all the styling, so the rendered page is unchanged. */
const { h1, sub } = Astro.props;
---
<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    {/* Was three background-image divs, all three fetched at full resolution
        before anything painted — 688 KB of hero before the headline. Now real
        <img> elements: the first is the LCP candidate and gets priority, the
        other two are lazy because they are not visible for 5 and 11 seconds. */}
    {slides.map((s, i) => (
      <div class="hero__slide" style={`animation-delay:${i * 5.5}s`}>
        <Img src={s} alt="" sizes="100vw" displayWidth={1600} class="hero__img"
             loading={i === 0 ? 'eager' : 'lazy'}
             fetchpriority={i === 0 ? 'high' : 'low'}
             decoding={i === 0 ? 'sync' : 'async'} />
      </div>
    ))}
  </div>
  <div class="hero__ov" aria-hidden="true"></div>
  <div class="hero__in">
    <div class="hero__copy">
      <h1 class="hero__h">{h1}</h1>
      <p class="hero__sub">{sub}</p>
      <a class="btn" href="#Contact"><small>Get a Quote</small>(416) 244-4113</a>
    </div>
    <EstimateForm id="top-estimate" />
  </div>
</section>

<style>
  .hero { position: relative; min-height: 85vh; display: flex; align-items: center; overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; background: #111; }
  .hero__slide {
    position: absolute; inset: 0;
    opacity: 0; animation: kb 16.5s infinite; /* 3 slides x 5.5s (5000ms hold + 500ms fade) */
  }
  /* replaces background-size:cover / background-position:center on the div.
     `height` overrides the global `img { height: auto }`. */
  .hero__img { width: 100%; height: 100%; object-fit: cover; object-position: center center; }
  /* measured: delay 5000ms, speed 500ms, loop -> 5.5s per slide, 500ms crossfade */
  @keyframes kb {
    0%     { opacity: 0; transform: scale(1); }
    3.03%  { opacity: 1; }
    30.3%  { opacity: 1; transform: scale(1.08); }
    33.33% { opacity: 0; transform: scale(1.08); }
    100%   { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__slide { animation: none; } .hero__slide:first-child { opacity: 1; }
  }
  /* background-color #000000D4 with --overlay-opacity .5 */
  .hero__ov { position: absolute; inset: 0; background: #000000D4; opacity: .5; }
  .hero__in {
    position: relative; width: 100%; max-width: var(--content); margin: 0 auto; padding: 0 10px;
    display: flex; flex-direction: row; align-items: center; gap: 40px;
  }
  .hero__copy { flex: 1 1 auto; align-self: center; }
  /* #e6fab6d 40/600 #FFF ; #cfc109b 18/400 #FFF */
  .hero__h   { font-size: 40px; font-weight: 600; color: #fff; text-align: start; margin-bottom: .3em; }
  /* was an <h2>, so it inherited line-height:1 from the global heading rule.
     Now a <p> — pin the line-height so the rendered hero is unchanged. */
  .hero__sub { font-size: 18px; font-weight: 400; line-height: 1; color: #fff; text-align: start; margin: 0 0 1.2em; }

  @media (max-width: 1024px) {
    .hero { min-height: 500px; padding: 50px 0; }
    .hero__in { flex-direction: column; justify-content: center; }
    .hero__h, .hero__sub { text-align: center; }
    .hero__copy { text-align: center; }
  }
  @media (max-width: 767px) { .hero__h { font-size: 30px; } }
</style>
