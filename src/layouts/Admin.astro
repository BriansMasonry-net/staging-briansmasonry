---
// Shell for the private /admin/ pages. Deliberately not Base.astro: no Google
// Ads tag (an admin page view is not a visitor), no public header or footer,
// no structured data. Brand tokens match Base.astro.
export interface Props {
  title: string;
}
const { title } = Astro.props as Props;
const email = Astro.locals.adminEmail;
---
<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} · Brian's Masonry admin</title>
  <link rel="icon" href="/favicon-32x32.png" sizes="32x32" />
  <style is:global>
    :root {
      --blue: #243F98;
      --red: #BD2031;
      --page: #F7F7F7;
      --line: #E1E3EA;
      --muted: #666;
      --r: 5px;
      --sans: "Helvetica", "Helvetica Neue", Roboto, Arial, sans-serif;
      --s-new: #243F98;
      --s-contacted: #B26A00;
      --s-won: #1E7B3A;
      --s-lost: #777;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--page); color: #222; font: 16px/1.5 var(--sans); }
    a { color: var(--blue); }
    .bar { background: var(--blue); color: #fff; }
    .bar-in { max-width: 1100px; margin: 0 auto; padding: 12px 16px; display: flex; gap: 12px; align-items: center; justify-content: space-between; }
    .bar a { color: #fff; text-decoration: none; font-weight: 700; }
    .bar form { margin: 0; display: flex; gap: 12px; align-items: center; font-size: 14px; }
    .bar .who { opacity: .85; overflow-wrap: anywhere; }
    @media (max-width: 600px) { .bar .who { display: none; } }
    main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 64px; }
    h1 { margin: 0 0 16px; font-size: 24px; }
    .card { background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: 20px; }
    label { display: block; font-weight: 700; font-size: 14px; margin: 0 0 6px; }
    input, select, textarea {
      width: 100%; font: inherit; padding: 10px 12px; border: 1px solid #B9BED0; border-radius: var(--r); background: #fff;
    }
    input:focus-visible, select:focus-visible, textarea:focus-visible, button:focus-visible, a:focus-visible {
      outline: 3px solid #8EA2E0; outline-offset: 1px;
    }
    textarea { min-height: 140px; resize: vertical; }
    .btn {
      display: inline-block; border: 0; border-radius: var(--r); background: var(--blue); color: #fff;
      font: 700 15px var(--sans); padding: 11px 20px; cursor: pointer; text-decoration: none;
    }
    .btn-quiet { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,.6); padding: 6px 12px; font-size: 13px; white-space: nowrap; }
    .note { padding: 10px 14px; border-radius: var(--r); margin: 0 0 16px; font-size: 15px; }
    .note-ok { background: #E7F4EA; color: #1E5C2F; }
    .note-err { background: #FBE9EB; color: #8A1622; }
    .muted { color: var(--muted); }
    .pill { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 700; color: #fff; text-transform: capitalize; }
    .pill-new { background: var(--s-new); }
    .pill-contacted { background: var(--s-contacted); }
    .pill-won { background: var(--s-won); }
    .pill-lost { background: var(--s-lost); }
  </style>
</head>
<body>
  <header class="bar">
    <div class="bar-in">
      <a href="/admin/">Brian's Masonry · Quotes</a>
      {email && (
        <form method="post" action="/admin/logout/">
          <span class="who">{email}</span>
          <button class="btn btn-quiet" type="submit">Sign out</button>
        </form>
      )}
    </div>
  </header>
  <main>
    <slot />
  </main>
</body>
</html>
