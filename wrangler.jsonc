{
  // `name` must match the Worker in the Cloudflare dashboard exactly.
  "name": "staging-briansmasonry",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],

  // The Custom Domains below are the only addresses this build should answer
  // on. Without these two, wrangler enables a public *.workers.dev URL and
  // per-version preview URLs on every deploy, which puts the client's site on
  // the open internet under another hostname.
  "workers_dev": false,
  "preview_urls": false,

  // This Worker's addresses, confirmed against the Cloudflare dashboard
  // (custom domains, not route patterns on someone else's zone). Declaring
  // them here keeps `wrangler deploy` from silently
  // matching whatever the dashboard has at deploy time — see gate 9 above for
  // why workers_dev/preview_urls stay off instead of relying on this alone.
  //
  // briansmasonry.net: cut over 2026-10-24, rolled back the same day, cut over
  // again 2026-10-27, rolled back to WordPress 2026-11-10. It is NOT attached
  // now: A briansmasonry.net 134.122.42.18 (proxied) points at WordPress on
  // Cloudways, and the three zone redirect rules (uploads -> image host,
  // www -> apex, trailing slash) are disabled, not deleted. To cut over again,
  // add { "pattern": "briansmasonry.net", "custom_domain": true } back here,
  // delete that A record, deploy, and re-enable the three rules.
  "routes": [
    { "pattern": "staging.briansmasonry.net", "custom_domain": true }
  ],

  // The adapter's own entrypoint (@astrojs/cloudflare v12+; older builds in the
  // house notes point `main` at ./dist/_worker.js/index.js, which this version
  // rejects at build time). It exists for /api/contact and nothing else — every
  // content page carries `export const prerender = true` and is served as a file.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  // Existing dashboard bindings, declared so a config-driven deploy does not
  // drop them. SESSION is the KV namespace src/pages/api/contact.ts reads for
  // the per-IP rate limit; IMAGES is the Cloudflare Images binding — nothing
  // in this codebase calls it yet, but it exists on the live Worker and is
  // preserved as-is rather than guessed at or removed.
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    { "binding": "SESSION", "id": "a1314bcbbb1246fba2c290fe1215a979" }
  ]
}
